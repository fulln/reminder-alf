# Environment Variables for Reminder-Alf
# Copy this file to .env and fill in your values

# OpenAI Configuration
REMINDER_ALF_OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration
REMINDER_ALF_ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Custom Endpoint Configuration (for OpenAI-compatible APIs)
REMINDER_ALF_CUSTOM_ENDPOINT=https://your-custom-api.com/v1
CUSTOM_API_KEY=your-custom-api-key-here

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tracking Configuration
# How many days to keep tracked items before cleanup
TRACKING_RETENTION_DAYS=30

# AI Configuration Defaults
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=30
