{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Parse Response",
  "description": "Expected response format from AI services for parsing natural language into events/reminders",
  "type": "object",
  "required": ["type", "confidence"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["event", "reminder", "unknown"],
      "description": "Type of item being created"
    },
    "event": {
      "type": ["object", "null"],
      "description": "Event data (only if type is 'event')",
      "properties": {
        "title": {
          "type": "string",
          "description": "Event title",
          "minLength": 1,
          "maxLength": 255
        },
        "start_date": {
          "type": "string",
          "format": "date-time",
          "description": "Event start date/time in ISO 8601 format"
        },
        "end_date": {
          "type": "string",
          "format": "date-time",
          "description": "Event end date/time in ISO 8601 format"
        },
        "location": {
          "type": ["string", "null"],
          "description": "Event location",
          "maxLength": 255
        },
        "notes": {
          "type": ["string", "null"],
          "description": "Additional event notes"
        },
        "calendar_name": {
          "type": ["string", "null"],
          "description": "Target calendar name"
        },
        "all_day": {
          "type": "boolean",
          "description": "Whether this is an all-day event",
          "default": false
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "Associated URL (meeting link, etc.)"
        },
        "recurrence_frequency": {
          "type": ["string", "null"],
          "enum": ["daily", "weekly", "monthly", "yearly", null],
          "description": "How often the event recurs"
        },
        "recurrence_interval": {
          "type": "integer",
          "description": "Repeat every N periods (e.g., every 2 weeks)",
          "minimum": 1,
          "default": 1
        },
        "recurrence_end_date": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When recurrence should end (ISO 8601)"
        },
        "alert_minutes_before": {
          "type": ["integer", "null"],
          "description": "Alert/notification time in minutes before event",
          "minimum": 0
        }
      },
      "required": ["title", "start_date", "end_date"],
      "additionalProperties": false
    },
    "reminder": {
      "type": ["object", "null"],
      "description": "Reminder data (only if type is 'reminder')",
      "properties": {
        "title": {
          "type": "string",
          "description": "Reminder title",
          "minLength": 1,
          "maxLength": 255
        },
        "notes": {
          "type": ["string", "null"],
          "description": "Additional reminder notes"
        },
        "due_date": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When reminder is due (ISO 8601)"
        },
        "priority": {
          "type": "integer",
          "description": "Priority level (0=None, 1=Low, 2=Medium, 3=High)",
          "enum": [0, 1, 2, 3],
          "default": 0
        },
        "list_name": {
          "type": ["string", "null"],
          "description": "Target reminder list name"
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "Associated URL"
        },
        "recurrence_frequency": {
          "type": ["string", "null"],
          "enum": ["daily", "weekly", "monthly", "yearly", null],
          "description": "How often the reminder recurs"
        },
        "recurrence_interval": {
          "type": "integer",
          "description": "Repeat every N periods",
          "minimum": 1,
          "default": 1
        },
        "recurrence_end_date": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When recurrence should end (ISO 8601)"
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "description": "Confidence score of the parse (0.0 to 1.0)",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "ambiguities": {
      "type": "array",
      "description": "List of ambiguous elements in the parse",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "event" },
        "event": { "type": "object" },
        "reminder": { "type": "null" }
      },
      "required": ["event"]
    },
    {
      "properties": {
        "type": { "const": "reminder" },
        "event": { "type": "null" },
        "reminder": { "type": "object" }
      },
      "required": ["reminder"]
    },
    {
      "properties": {
        "type": { "const": "unknown" },
        "event": { "type": "null" },
        "reminder": { "type": "null" }
      }
    }
  ],
