  "validation_rules": {
    "event": {
      "title": "Must not be empty",
      "dates": "end_date must be after start_date",
      "all_day": "If true, times should be midnight",
      "recurrence": "If recurrence_frequency is set, recurrence_interval must be >= 1",
      "alert": "alert_minutes_before must be >= 0 if set"
    },
    "reminder": {
      "title": "Must not be empty",
      "priority": "Must be 0, 1, 2, or 3",
      "recurrence": "If recurrence_frequency is set, recurrence_interval must be >= 1",
      "due_date": "Should be in future (optional)"
    },
    "general": {
      "confidence": "Must be between 0.0 and 1.0",
      "type_consistency": "Only event or reminder should be set, not both",
      "ambiguities": "Should be empty array if confidence >= 0.8"
    }
  }
}
