{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "reminder-alf",
    "title": "Reminder Alf",
    "description": "AI-powered natural language calendar and reminder management for macOS",
    "icon": "extension-icon.png",
    "author": "fulln",
    "categories": [
        "Productivity",
        "Applications"
    ],
    "license": "MIT",
    "commands": [
        {
            "name": "create-item",
            "title": "Create Event or Reminder",
            "description": "Parse natural language to create calendar events or reminders",
            "mode": "view"
        },
        {
            "name": "list-items",
            "title": "List Recent Items",
            "description": "Show recently created events and reminders",
            "mode": "view"
        },
        {
            "name": "config-status",
            "title": "Configuration Status",
            "description": "Check AI configuration status",
            "mode": "view"
        }
    ],
    "preferences": [
        {
            "name": "useRaycastAI",
            "title": "Use Raycast AI",
            "label": "Enable Raycast AI",
            "description": "Use Raycast's built-in AI instead of Python backend (requires Raycast Pro)",
            "type": "checkbox",
            "default": false,
            "required": false
        },
        {
            "name": "pythonPath",
            "title": "Python Path",
            "description": "Path to Python 3.11+ executable",
            "type": "textfield",
            "default": "python3.11",
            "required": false
        },
        {
            "name": "projectPath",
            "title": "Project Path",
            "description": "Path to reminder-alf project directory",
            "type": "textfield",
            "required": false
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.83.0"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^1.0.11",
        "@types/node": "22.5.4",
        "@types/react": "18.3.3",
        "eslint": "^8.57.0",
        "prettier": "^3.3.3",
        "typescript": "^5.4.5"
    },
    "scripts": {
        "build": "ray build --skip-types -e dist -o dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint",
        "prepublishOnly": "echo \"Error: no publishing\" && exit 1",
        "publish": "npx @raycast/api@latest publish"
    }
}